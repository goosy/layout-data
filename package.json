{
	"name": "layout-data",
	"version": "0.5.0",
	"description": "Structured, reactive, buffer-based data blocks with named, typed tags",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./dev": {
			"types": "./dist/dev.d.ts",
			"default": "./dist/dev.js"
		}
	},
	"bin": {
		"layout-types": "./dist/dev.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20.11"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "^20.19.43",
		"eslint": "10.12.0",
		"globals": "17.13.0",
		"rolldown": "1.2.15",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"build": "rolldown -c && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --outDir .local/types",
		"test": "pnpm build && pnpm test:types && node --test && pnpm test:dist",
		"test:types": "tsc -p type_check",
		"test:dist": "node --test --import ./test/api/dist.js \"test/api/*_test.js\"",
		"lint": "eslint .",
		"bench": "node bench/change_detection_bench.js",
		"prepare": "pnpm build"
	},
	"keywords": [
		"buffer",
		"struct",
		"tag",
		"PLC",
		"layout"
	],
	"author": "Goosy Jo <goosy.jo@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goosy/layout-data.git"
	},
	"license": "MPL-2.0",
	"packageManager": "pnpm@12.5.1"
}
