{
	"name": "tagged-data",
	"version": "0.1.0",
	"description": "Structured, reactive, buffer-based data blocks with named, typed tags",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/tagged-data.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.11"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "^20.19.43",
		"eslint": "10.12.0",
		"globals": "17.13.0",
		"rolldown": "^1.2.12",
		"typescript": "^5.9.3",
		"yaml": "^2.9.1"
	},
	"scripts": {
		"build": "rolldown -c",
		"typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --outDir .local/types",
		"test": "pnpm build && pnpm test:types && node --test",
		"test:types": "tsc -p type_check",
		"lint": "eslint .",
		"prepare": "pnpm build"
	},
	"keywords": [
		"buffer",
		"struct",
		"tag",
		"PLC",
		"layout"
	],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@12.5.1"
}
